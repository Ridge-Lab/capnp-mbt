///|
pub(all) struct DocumentReader {
  inner : @capnp.StructReader
}

///|
pub(all) struct DocumentBuilder {
  inner : @capnp.StructBuilder
}

///|
pub fn DocumentReader::from_message(
  message : @capnp.Message,
) -> DocumentReader raise @capnp.CapnpError {
  { inner: message.root(), }
}

///|
pub fn DocumentBuilder::init_root(
  message : @capnp.Builder,
) -> DocumentBuilder raise @capnp.CapnpError {
  { inner: message.init_root(0, 1), }
}

