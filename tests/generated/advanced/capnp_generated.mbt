  self : SwitchingReader,
) -> SwitchingConfigurationReader raise @capnp.CapnpError {
  if self.inner.get_uint16(2) != 1U {
    raise @capnp.CapnpError::TypeMismatch("inactive union field")
  }
  { inner: self.inner, }
}

///|
