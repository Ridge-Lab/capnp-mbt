///|
pub fn SwitchingReader::is_none(
  self : SwitchingReader,
) -> Bool raise @capnp.CapnpError {
  self.inner.get_uint16(2) == 0U
}

///|
pub fn SwitchingReader::get_none(
  self : SwitchingReader,
) -> Unit raise @capnp.CapnpError {
  if self.inner.get_uint16(2) != 0U {
    raise @capnp.CapnpError::TypeMismatch("inactive union field")
  }
  ignore(self)
  ()
}

///|
pub fn SwitchingBuilder::set_none(
  self : SwitchingBuilder,
) -> Unit raise @capnp.CapnpError {
  self.inner.set_bool(1, false)
  self.inner.clear_pointer(0)
  self.inner.set_uint64(8, 0UL)
  self.inner.set_uint16(2, 0U)
  ignore(self)
}

///|
pub fn SwitchingReader::is_configuration(
  self : SwitchingReader,
) -> Bool raise @capnp.CapnpError {
  self.inner.get_uint16(2) == 1U
}

///|
