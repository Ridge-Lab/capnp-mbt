  self : SwitchingReader,
) -> UInt64 raise @capnp.CapnpError {
  if self.inner.get_uint16(2) != 2U {
    raise @capnp.CapnpError::TypeMismatch("inactive union field")
  }
  self.inner.get_uint64(8, default=0UL)
}

///|
