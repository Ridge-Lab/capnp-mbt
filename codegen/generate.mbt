///|
/// Compile the official capnp compiler's binary CodeGeneratorRequest to typed
/// MoonBit views/builders. All declarations (including imports) share one package.
pub fn generate(request : Bytes) -> Array[GeneratedFile] raise CodegenError {
  generate_impl(request) catch {
    CodegenError::InvalidRequest(message) => raise InvalidRequest(message)
    CodegenError::UnsupportedSchema(message) => raise UnsupportedSchema(message)
    e => raise InvalidRequest("cannot decode CodeGeneratorRequest: \{e}")
  }
}

///|
fn generate_impl(request : Bytes) -> Array[GeneratedFile] raise {
  if request.length() > 16 * 1024 * 1024 {
    raise InvalidRequest("schema request exceeds 16 MiB")
  }
  let root = @capnp.read_message(request).root()
  let raw_nodes = read_nodes(root)
  let nodes = specialize_nodes(raw_nodes)
  allocate_names(nodes)
  validate_names(nodes)
  let requested = root.get_list(1)
  if requested.length() == 0 {
    raise InvalidRequest("request contains no requested files")
  }
  for i in 0..<requested.length() {
    let file = requested.get_struct(i)
    let n = lookup(nodes, file.get_uint64(0))
    if n.kind != 0 {
      raise InvalidRequest("requested file ID is not a file")
    }
  }
  let out = StringBuilder()
  out.write_string(
    "// Generated by capnpc-moonbit from the official Cap'n Proto compiler request.\n// Do not edit. Nested declarations are flattened; IDs disambiguate collisions.\n// Known generic bindings are specialized. Unbound parameters and recursively\n// growing generic boundaries use lossless dynamic views via public .inner handles.\n// Interface fields expose opaque capability indices; no RPC transport is generated.\n",
  )
  let mut needs_default = false
  let mut needs_field_default = false
  for node in nodes {
    if node.kind == 1 {
      let names : Map[String, Bool] = Map([])
      for field in node.fields {
        let name = generated_field_name(field)
        if name == "" || names.contains(name) {
          raise UnsupportedSchema(
            "field names collide after MoonBit normalization: \{node.name}.\{field.name}",
          )
        }
        names[name] = true
        if field_uses_pointer_default(field) {
          needs_default = true
          needs_field_default = true
        }
      }
    }
    if constant_uses_pointer(node) {
      needs_default = true
    }
  }
  if needs_default {
    let payload = pointer_default_payload(raw_nodes)
    emit_block(
      out,
      "fn capnp_schema_node(node : Int) -> @capnp.StructReader raise @capnp.CapnpError {\n  let payload : Bytes = \{bytes_literal(payload)}\n  @capnp.read_message(payload).root().get_list(0).get_struct(node)\n}",
    )
    // Emit this only when used: scalar-only constant schemas need no pointer helper.
    if needs_field_default {
      emit_block(
        out, "fn capnp_schema_default(node : Int, field : Int) -> @capnp.PointerReader raise @capnp.CapnpError {\n  capnp_schema_node(node).get_list(3).get_struct(field).get_struct(3).get_pointer(0)\n}",
      )
    }
  }
  for node in nodes {
    match node.kind {
      0 | 3 | 5 => () // File/interface/annotation declarations carry no serialization object.
      1 => emit_struct(out, node, nodes)
      2 => emit_enum(out, node, nodes)
      4 => emit_constant(out, node, nodes)
      _ => raise UnsupportedSchema("unknown declaration kind \{node.kind}")
    }
  }
  [{ path: "capnp_generated.mbt", content: out.to_string(), }]
}
